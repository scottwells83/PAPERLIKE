<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PaperwhiteReader.App"
             Name="PaperLike"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="Foreground" Value="#403B33" />
            <Setter Property="Background" Value="#EAE6DE" />
            <Setter Property="BorderBrush" Value="#D5CFC3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.primaryButton">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#74634E" />
            <Setter Property="BorderBrush" Value="#74634E" />
        </Style>
        <Style Selector="Button.addBookButton">
            <Setter Property="Foreground" Value="#4D473D" />
            <Setter Property="Background" Value="#EEEAE2" />
            <Setter Property="BorderBrush" Value="#DEDAD0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="#403B33" />
            <Setter Property="Background" Value="#EAE6DE" />
            <Setter Property="BorderBrush" Value="#D5CFC3" />
        </Style>
    </Application.Styles>
</Application>
